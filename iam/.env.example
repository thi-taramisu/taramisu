PG_PASS=
AUTHENTIK_SECRET_KEY=
DEV_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Token of the taramisu-api service account; the API reads users and groups with it.
AUTHENTIK_API_TOKEN=

APP_URL=http://localhost
OIDC_CLIENT_ID=taramisu

# Optional Sentry reporting. Compose and published images default to production.
# The backend DSN is forwarded only through the proxy's internal ingest listener.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=
