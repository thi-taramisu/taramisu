PG_PASS=
AUTHENTIK_SECRET_KEY=
DEV_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Token of the taramisu-api service account; the API reads users and groups with it.
AUTHENTIK_API_TOKEN=
# Personal SAIA API key (https://saia.gwdg.de/keys) for the LLM service; empty disables the assistant.
LLM_API_KEY=
# Optional: trace assistant requests in a self-hosted Langfuse (see deploy/README.md); set all three or none.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

APP_URL=http://localhost
# API log level: debug, info (default), warn, or error.
# LOG_LEVEL=info
# Audit history of deleted projects is deleted after this period (default one year).
# AUDIT_RETENTION_AFTER_DELETE=8760h
OIDC_CLIENT_ID=taramisu
