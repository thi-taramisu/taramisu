# yaml-language-server: $schema=https://goauthentik.io/blueprints/schema.json
version: 1
metadata:
  name: Taramisu branding
  labels:
    blueprints.goauthentik.io/instantiate: "false"
entries:
  - model: authentik_brands.brand
    identifiers:
      domain: authentik-default
      default: true
    attrs:
      branding_title: Taramisu
      branding_logo: /static/dist/assets/icons/blank.svg
      branding_favicon: /static/dist/assets/icons/blank.svg
      branding_default_flow_background: /static/dist/assets/icons/blank.svg
      branding_custom_css: |
        @@THEME@@
        ak-flow-executor {
          --pf-global--FontFamily--text: "Geist Variable", sans-serif;
          --pf-global--FontFamily--heading: var(--pf-global--FontFamily--text);
          font-family: var(--pf-global--FontFamily--text);
        }
        ak-flow-executor::part(branding),
        ak-flow-executor::part(footer) {
          display: none;
        }
        ak-flow-executor::part(login) {
          --ak-c-login__main-ColumnWidth: min(28rem, calc(100vw - 2rem));
          grid-template-rows: 1fr auto 1fr;
          background: var(--taramisu-background);
        }
        ak-flow-executor::part(locale-select) {
          color: var(--taramisu-foreground);
          text-shadow: none;
        }
        ak-flow-executor::part(main) {
          --ak-c-login__main--BoxShadow: 0 12px 40px rgb(0 0 0 / 12%);
          align-self: center;
          background: var(--taramisu-card);
          color: var(--taramisu-card-foreground);
          border: 1px solid var(--taramisu-border);
          border-radius: var(--taramisu-radius);
        }
        /* Brand CSS is adopted into Authentik's shadow roots. Scope controls to flows. */
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) .pf-c-button.pf-m-primary {
          font-family: inherit;
          font-size: 0.875rem;
          font-weight: 500;
          background: var(--taramisu-primary);
          color: var(--taramisu-primary-foreground);
          border-radius: calc(var(--taramisu-radius) * 0.8);
        }
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) .pf-c-button.pf-m-primary:hover:not(:disabled) {
          background: color-mix(in srgb, var(--taramisu-primary) 90%, transparent);
        }
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) .pf-c-button:focus-visible,
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) a:focus-visible {
          outline: 2px solid var(--taramisu-ring);
          outline-offset: 2px;
        }
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) .pf-c-button:disabled {
          opacity: 0.5;
        }
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) .pf-c-form-control {
          font-family: inherit;
          --pf-c-form-control--BackgroundColor: var(--taramisu-card);
          --pf-c-form-control--Color: var(--taramisu-card-foreground);
          --pf-c-form-control--BorderTopColor: var(--taramisu-input);
          --pf-c-form-control--BorderRightColor: var(--taramisu-input);
          --pf-c-form-control--BorderBottomColor: var(--taramisu-input);
          --pf-c-form-control--BorderLeftColor: var(--taramisu-input);
          --pf-c-form-control--BorderRadius: calc(var(--taramisu-radius) * 0.8);
          --pf-c-form-control--focus--BorderBottomColor: var(--taramisu-ring);
          --pf-c-form-control--hover--BorderBottomColor: var(--taramisu-ring);
          --pf-c-form-control--invalid--BorderBottomColor: var(--taramisu-destructive);
          --pf-c-form-control--placeholder--Color: var(--taramisu-muted-foreground);
        }
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) .pf-c-login__main-footer-band {
          background: var(--taramisu-muted);
          color: var(--taramisu-foreground);
        }
        :is(:host-context(ak-flow-executor), :host(ak-stage-identification), :host(ak-stage-password), :host(ak-stage-prompt)) a {
          color: var(--taramisu-primary);
        }
  - model: authentik_flows.flow
    identifiers:
      slug: default-authentication-flow
    attrs:
      title: Sign in to Taramisu
