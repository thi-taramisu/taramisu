server {
  listen 5173;
  root /usr/share/nginx/html;
  index index.html;

  # Cache hash-named assets for a long time
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Unbekannte Pfade -> index.html
  location / {
    try_files $uri /index.html;
  }
}
