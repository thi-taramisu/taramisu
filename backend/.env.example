HTTP_ADDR=:8080
DATABASE_URL=postgres://taramisu:taramisu@localhost:5432/taramisu?sslmode=disable
OIDC_ISSUER=http://localhost/auth/application/o/taramisu/
OIDC_JWKS_URL=http://localhost:9000/auth/application/o/taramisu/jwks/
OIDC_CLIENT_ID=taramisu
# Members API: copy AUTHENTIK_API_TOKEN from iam/.env.
AUTHENTIK_API_URL=http://localhost:9000/auth
AUTHENTIK_API_TOKEN=
# Log level: debug, info (default), warn, or error.
LOG_LEVEL=info
# Audit history of deleted projects is deleted after this period (default one year).
AUDIT_RETENTION_AFTER_DELETE=8760h
