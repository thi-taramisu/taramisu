{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ItemDefinition": {
        "additionalProperties": false,
        "properties": {
          "architectural_design": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "cybersecurity_specs_wp_10_01": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "item_definition_wp_09_01": {
            "type": [
              "string",
              "null"
            ]
          },
          "lifecycle_phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "scope_type": {
            "enum": [
              "ITEM",
              "COMPONENT"
            ],
            "type": "string"
          },
          "tara_project_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tara_project_id",
          "created_at",
          "name",
          "scope_type"
        ],
        "type": "object"
      },
      "ItemDefinitionBody": {
        "additionalProperties": false,
        "properties": {
          "architectural_design": {
            "type": [
              "string",
              "null"
            ]
          },
          "cybersecurity_specs_wp_10_01": {
            "type": [
              "string",
              "null"
            ]
          },
          "item_definition_wp_09_01": {
            "type": [
              "string",
              "null"
            ]
          },
          "lifecycle_phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "scope_type": {
            "enum": [
              "ITEM",
              "COMPONENT"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "scope_type"
        ],
        "type": "object"
      },
      "PatchItemDefinitionBody": {
        "additionalProperties": false,
        "properties": {
          "architectural_design": {
            "type": [
              "string",
              "null"
            ]
          },
          "cybersecurity_specs_wp_10_01": {
            "type": [
              "string",
              "null"
            ]
          },
          "item_definition_wp_09_01": {
            "type": [
              "string",
              "null"
            ]
          },
          "lifecycle_phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "scope_type": {
            "enum": [
              "ITEM",
              "COMPONENT"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ReadyOutputBody": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "message"
        ],
        "type": "object"
      },
      "StatusOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
