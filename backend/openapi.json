        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "issuer",
          "subject"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
